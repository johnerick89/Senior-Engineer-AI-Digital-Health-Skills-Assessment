
# Host machine (relational_db published on localhost:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Docker Compose overrides DATABASE_URL to:
# postgresql://postgres:postgres@relational_db:5432/postgres

OPENAI_API_KEY=sk-proj-your-key-here
OPENROUTER_API_KEY=sk-or-v1-your-key-here
RAG_CORE_GENERATION_MODEL=gpt-4o-mini
RAG_CORE_RETRIEVAL_K=20
RAG_CORE_INGESTION_BATCH_SIZE=100
